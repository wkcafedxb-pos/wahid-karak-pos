rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CHANGE THIS to the owner's sign-in email(s), in lowercase.
    // Use the same email(s) as OWNER_EMAILS in firebase-config.js.
    function ownerEmails() { return ['owner@example.com']; }

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ownerEmails();
    }
    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasRole(roles) { return signedIn() && exists(myDoc()) && get(myDoc()).data.role in roles; }
    function isManager() { return isOwner() || hasRole(['owner', 'manager']); }
    function isStaff()   { return isManager() || hasRole(['staff']); }
    function canRead()   { return isStaff() || hasRole(['accountant']); }

    // Team accounts: everyone creates their own (as "pending"); only the owner changes roles.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.role == 'pending' || isOwner());
      allow update, delete: if isOwner();
    }

    // Settings, menu, staff list: managers. Raw materials and suppliers: staff too.
    match /cfg/{doc} {
      allow read: if canRead();
      allow write: if isManager() || (isStaff() && doc in ['inv', 'sup']);
    }

    // Day-to-day records.
    match /{col}/{doc} {
      allow read: if canRead() && col in ['orders','tickets','cust','exp','pur','mov','po','close'];
      allow write: if isStaff() && col in ['orders','tickets','cust','exp','pur','mov','po','close'];
    }
  }
}
